{
  "version": 2,
  "name": "ip-sakti-ayush",
  "builds": [
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ],
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/top-topics",
      "destination": "/frontend/top_topics.html",
      "permanent": true
    },
    {
      "source": "/top-legal",
      "destination": "/frontend/top_legal.html",
      "permanent": true
    }
  ]
}
